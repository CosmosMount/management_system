generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  DRAFT
  MANAGEMENT_REVIEW
  TEACHER_REVIEW
  PENDING_APPLICANT_DOCS
  PENDING_FINANCE_REVIEW
  PENDING_APPLICANT_CONFIRM
  COMPLETED
  REJECTED
}

enum UserRoleType {
  SUPER_ADMIN
  TEAM_ADMIN
  TECH_GROUP_ADMIN
  TEACHER
  FINANCE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FileAssetKind {
  ORDER_ATTACHMENT
  ORDER_ITEM_IMAGE
  FEEDBACK_ATTACHMENT
  USER_SIGNATURE
  TEMP_UPLOAD
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum IdentityProvider {
  FEISHU
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum ProjectManagementSystemRole {
  SYSTEM_ADMINISTRATOR
  TEAM_ADMINISTRATOR
  RESOURCE_MANAGER
  AUDITOR
  SUPER_ADMINISTRATOR
  PROJECT_ADMINISTRATOR
  GROUP_LEADER
}

enum TaskStatus {
  DRAFT
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
  ARCHIVED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskMemberRole {
  OWNER
  PARTICIPANT
  LEAD
  MEMBER
  REVIEWER
  VIEWER
}

enum PlanVersionStatus {
  DRAFT
  CURRENT
  HISTORICAL
  ABANDONED
}

enum TaskNodeType {
  MILESTONE
  REVISION
  TERMINATION
}

enum TaskNodeStatus {
  PENDING
  ACTIVE
  COMPLETED
  REVISED
  CANCELLED
}

enum RevisionStatus {
  DRAFT
  PENDING_APPROVAL
  EFFECTIVE
  REJECTED
  CANCELLED
}

enum MilestoneReviewResult {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum ReviewEvidenceKind {
  FILE
  LINK
  TEXT
}

enum TerminationOutcome {
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum WorkSegmentType {
  PLANNED
  ACTUAL
}

enum WorkSegmentStatus {
  PLANNED
  IN_PROGRESS
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum WorkSegmentRole {
  OWNER
  LEAD
  DEVELOPER
  DESIGNER
  REVIEWER
  SUPPORT
  OBSERVER
  CUSTOM
}

enum WorkSegmentChangeAction {
  CREATE
  UPDATE
  SPLIT
  MERGE
  CONFIRM
  CANCEL
  DELETE
  RELINK
}

enum ProjectManagementNotificationCategory {
  TASK
  MILESTONE
  REVIEW
  REVISION
  WORK_SEGMENT
  ACCOUNT_SECURITY
}

enum ProjectManagementNotificationChannel {
  IN_APP
  FEISHU
}

enum AuditSource {
  WEB
  CRON
  MIGRATION
  SYSTEM
}

model Account {
  id                        String                   @id @default(uuid())
  projectAccessStatus       AccountStatus            @default(ACTIVE)
  lastLoginAt               DateTime?                @db.Timestamptz(6)
  identities                AccountIdentity[]
  person                    Person?
  createdTags               Tag[]                    @relation("TagCreatedBy")
  createdTasks              Task[]                   @relation("TaskCreatedBy")
  createdTaskMembers        TaskMember[]             @relation("TaskMemberCreatedBy")
  createdPlanVersions       TaskPlanVersion[]        @relation("PlanVersionCreatedBy")
  createdTaskNodes          TaskNode[]               @relation("TaskNodeCreatedBy")
  reviewedRevisions         RevisionNode[]           @relation("RevisionReviewedBy")
  submittedMilestoneReviews MilestoneReview[]        @relation("MilestoneReviewSubmittedBy")
  reviewedMilestones        MilestoneReview[]        @relation("MilestoneReviewReviewer")
  revokedMilestoneReviews   MilestoneReview[]        @relation("MilestoneReviewRevokedBy")
  confirmedTerminations     TerminationNode[]        @relation("TerminationConfirmedBy")
  createdWorkSegments       WorkSegment[]            @relation("WorkSegmentCreatedBy")
  updatedWorkSegments       WorkSegment[]            @relation("WorkSegmentUpdatedBy")
  createdWorkSegmentSources WorkSegmentSource[]      @relation("WorkSegmentSourceCreatedBy")
  workSegmentChanges        WorkSegmentChange[]      @relation("WorkSegmentChangeActor")
  systemRoles               SystemRoleAssignment[]   @relation("SystemRoleAccount")
  grantedSystemRoles        SystemRoleAssignment[]   @relation("SystemRoleGrantedBy")
  revokedSystemRoles        SystemRoleAssignment[]   @relation("SystemRoleRevokedBy")
  reimbursementRoles        UserRole[]               @relation("UserRoleAccount")
  grantedReimbursementRoles UserRole[]               @relation("UserRoleGrantedBy")
  revokedReimbursementRoles UserRole[]               @relation("UserRoleRevokedBy")
  reimbursementUser         User?
  teamApprovedOrders        PurchaseOrder[]          @relation("PurchaseOrderTeamApprover")
  techGroupApprovedOrders   PurchaseOrder[]          @relation("PurchaseOrderTechGroupApprover")
  notificationPreferences   NotificationPreference[]
  inAppNotifications        InAppNotification[]
  auditEvents               DomainAuditEvent[]       @relation("AuditActorAccount")
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @db.Timestamptz(6)
}

model AccountIdentity {
  id              String           @id @default(uuid())
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  provider        IdentityProvider
  providerSubject String
  tenantId        String           @default("default")
  openId          String?
  unionId         String?
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([provider, tenantId, providerSubject])
  @@unique([provider, tenantId, openId])
  @@unique([provider, tenantId, unionId])
  @@index([accountId])
}

model Person {
  id           String             @id @default(uuid())
  accountId    String?            @unique
  account      Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  displayName  String
  avatar       String?
  status       PersonStatus       @default(ACTIVE)
  taskMembers  TaskMember[]
  workSegments WorkSegment[]
  auditEvents  DomainAuditEvent[] @relation("AuditActorPerson")
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)

  @@index([displayName])
  @@index([status])
}

model User {
  id            String          @id @default(uuid())
  accountId     String          @unique
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  openId        String          @unique
  unionId       String?         @unique
  name          String
  email         String?
  avatar        String?
  signaturePath String?
  createdAt     DateTime        @default(now())
  orders        PurchaseOrder[]
}

model ProcurementFeishuCard {
  id        String   @id @default(uuid())
  orderId   String
  openId    String
  cardId    String
  botKind   String
  cardStage String   @default("")
  sequence  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, openId])
  @@index([orderId])
}

model UserRole {
  id                 String       @id @default(uuid())
  accountId          String?
  account            Account?     @relation("UserRoleAccount", fields: [accountId], references: [id], onDelete: Restrict)
  openId             String
  role               UserRoleType
  team               String       @default("")
  techGroup          String       @default("")
  grantedByAccountId String?
  grantedBy          Account?     @relation("UserRoleGrantedBy", fields: [grantedByAccountId], references: [id], onDelete: SetNull)
  revokedByAccountId String?
  revokedBy          Account?     @relation("UserRoleRevokedBy", fields: [revokedByAccountId], references: [id], onDelete: SetNull)
  revokedAt          DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)

  @@index([accountId, role])
  @@index([openId, role])
  @@index([revokedAt])
}

model ProcurementBudgetPool {
  id                 String   @id @default(uuid())
  /**
   * 项目名（导入表「项目」列）
   */
  description        String   @default("")
  team               String
  techGroup          String
  period             String
  budgetAmount       Float
  /**
   * 看板/管理页展示顺序，与 Excel 导入行序一致
   */
  sortOrder          Int      @default(0)
  lastAlertThreshold Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([description, team, techGroup, period])
}

model PurchaseOrder {
  id                         String         @id @default(uuid())
  orderNo                    String         @unique
  initiatorId                String
  initiator                  User           @relation(fields: [initiatorId], references: [id])
  initiatorName              String
  team                       String
  techGroup                  String
  totalPrice                 Float          @default(0)
  teamApproved               Boolean        @default(false)
  techGroupApproved          Boolean        @default(false)
  teamApproverAccountId      String?
  teamApproverAccount        Account?       @relation("PurchaseOrderTeamApprover", fields: [teamApproverAccountId], references: [id], onDelete: Restrict)
  teamApproverOpenId         String?
  techGroupApproverAccountId String?
  techGroupApproverAccount   Account?       @relation("PurchaseOrderTechGroupApprover", fields: [techGroupApproverAccountId], references: [id], onDelete: Restrict)
  techGroupApproverOpenId    String?
  invoicePaths               String         @default("[]")
  invoicePath                String?
  listDocPath                String?
  screenshotPath             String?
  status                     OrderStatus    @default(DRAFT)
  isWorkshopFee              Boolean        @default(false)
  rejectionReason            String?
  rejectedAt                 DateTime?
  rejectedByName             String?
  lastReminderAt             DateTime?
  statusEnteredAt            DateTime       @default(now())
  items                      PurchaseItem[]
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([teamApproverAccountId])
  @@index([techGroupApproverAccountId])
}

enum PurchaseItemKind {
  COMPONENT
  STANDARD_PART
  PROCESSING_FEE
}

model ProcessingVendor {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model PurchaseItem {
  id                 String           @id @default(uuid())
  orderId            String
  order              PurchaseOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name               String
  spec               String
  itemKind           PurchaseItemKind @default(COMPONENT)
  purchaseLink       String           @default("")
  referenceImagePath String?
  processingVendor   String           @default("")
  quantity           Int
  unitPrice          Float
  photoPath          String?
  updatedAt          DateTime         @default(now()) @updatedAt
}

model Feedback {
  id              String            @id @default(uuid())
  submitterOpenId String
  submitterName   String
  status          FeedbackStatus    @default(OPEN)
  lastMessageAt   DateTime          @default(now())
  closedAt        DateTime?
  messages        FeedbackMessage[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([submitterOpenId])
  @@index([status, lastMessageAt])
}

model FeedbackMessage {
  id           String               @id @default(uuid())
  feedbackId   String
  feedback     Feedback             @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorOpenId String
  authorName   String
  body         String               @default("")
  attachments  FeedbackAttachment[]
  createdAt    DateTime             @default(now())

  @@index([feedbackId, createdAt])
}

model FeedbackAttachment {
  id        String          @id @default(uuid())
  messageId String
  message   FeedbackMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  path      String
  fileName  String
  mimeType  String
  size      Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
}

model FileAsset {
  id                   String           @id @default(uuid())
  publicPath           String           @unique
  storagePath          String
  kind                 FileAssetKind
  mimeType             String
  size                 Int
  orderId              String?
  feedbackId           String?
  signatureOwnerOpenId String?
  ownerOpenId          String?
  createdAt            DateTime         @default(now())
  reviewEvidences      ReviewEvidence[]

  @@index([orderId])
  @@index([feedbackId])
  @@index([signatureOwnerOpenId])
  @@index([ownerOpenId])
}

model Tag {
  id                 String       @id @default(uuid())
  name               String
  color              String       @default("")
  description        String       @default("")
  createdByAccountId String
  createdBy          Account      @relation("TagCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  archivedAt         DateTime?    @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  taskTags           TaskTag[]
  segmentTags        SegmentTag[]

  @@index([name])
  @@index([archivedAt])
  @@index([createdByAccountId])
}

model Task {
  id                    String              @id @default(uuid())
  title                 String
  description           String              @default("")
  team                  String              @default("")
  techGroup             String              @default("")
  status                TaskStatus          @default(DRAFT)
  priority              TaskPriority        @default(MEDIUM)
  currentPlanVersionId  String              @unique
  currentPlanVersion    TaskPlanVersion     @relation("CurrentTaskPlanVersion", fields: [currentPlanVersionId], references: [id], onDelete: Restrict)
  activeMilestoneNodeId String?             @unique
  activeMilestoneNode   TaskNode?           @relation("ActiveMilestoneNode", fields: [activeMilestoneNodeId], references: [id], onDelete: SetNull)
  lockVersion           Int                 @default(0)
  startedAt             DateTime?           @db.Timestamptz(6)
  endedAt               DateTime?           @db.Timestamptz(6)
  archivedAt            DateTime?           @db.Timestamptz(6)
  deletedAt             DateTime?           @db.Timestamptz(6)
  relatedTaskId         String?
  relatedTask           Task?               @relation("RelatedTasks", fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedTasks          Task[]              @relation("RelatedTasks")
  createdByAccountId    String
  createdBy             Account             @relation("TaskCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  members               TaskMember[]
  tags                  TaskTag[]
  planVersions          TaskPlanVersion[]   @relation("TaskPlanVersions")
  nodes                 TaskNode[]
  workSegments          WorkSegment[]
  inAppNotifications    InAppNotification[]
  auditEvents           DomainAuditEvent[]
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status, team, techGroup])
  @@index([createdByAccountId])
  @@index([deletedAt])
  @@index([relatedTaskId])
  @@index([updatedAt, id])
}

model TaskTag {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([taskId, tagId])
  @@index([tagId])
}

model TaskMember {
  id                 String         @id @default(uuid())
  taskId             String
  task               Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  personId           String
  person             Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  role               TaskMemberRole
  createdByAccountId String?
  createdBy          Account?       @relation("TaskMemberCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  removedAt          DateTime?      @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)

  @@index([taskId, personId])
  @@index([personId, role])
  @@index([createdByAccountId])
  @@index([removedAt])
}

model TaskPlanVersion {
  id                  String            @id @default(uuid())
  taskId              String
  task                Task              @relation("TaskPlanVersions", fields: [taskId], references: [id], onDelete: Restrict)
  versionNo           Int
  status              PlanVersionStatus @default(DRAFT)
  idempotencyKey      String?
  creationRequestHash String            @default("")
  baseVersionId       String?
  baseVersion         TaskPlanVersion?  @relation("PlanVersionBase", fields: [baseVersionId], references: [id], onDelete: SetNull)
  derivedVersions     TaskPlanVersion[] @relation("PlanVersionBase")
  revisionNodeId      String?           @unique
  revisionNode        RevisionNode?     @relation("RevisionTargetPlanVersion", fields: [revisionNodeId], references: [id], onDelete: SetNull)
  reason              String            @default("")
  plannedStartAt      DateTime?         @db.Timestamptz(6)
  createdByAccountId  String
  createdBy           Account           @relation("PlanVersionCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  activatedAt         DateTime?         @db.Timestamptz(6)
  snapshotHash        String            @default("")
  currentForTask      Task?             @relation("CurrentTaskPlanVersion")
  nodes               PlanVersionNode[]
  revisionBaseNodes   RevisionNode[]    @relation("RevisionBasePlanVersion")
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([taskId, versionNo])
  @@index([taskId, status])
  @@index([createdByAccountId, idempotencyKey])
  @@index([baseVersionId])
  @@index([createdByAccountId])
}

model TaskNode {
  id                  String            @id @default(uuid())
  taskId              String
  task                Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  type                TaskNodeType
  status              TaskNodeStatus    @default(PENDING)
  businessDescription String            @default("")
  createdByAccountId  String
  createdBy           Account           @relation("TaskNodeCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  deletedAt           DateTime?         @db.Timestamptz(6)
  planVersionEntries  PlanVersionNode[]
  milestone           MilestoneNode?
  revision            RevisionNode?
  termination         TerminationNode?
  revisedFrom         RevisionNode[]    @relation("RevisionRevisedFromNode")
  activeForTask       Task?             @relation("ActiveMilestoneNode")
  workSegments        WorkSegment[]
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  @@index([taskId, type, status])
  @@index([createdByAccountId])
  @@index([deletedAt])
}

model PlanVersionNode {
  id             String          @id @default(uuid())
  planVersionId  String
  planVersion    TaskPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  nodeId         String
  node           TaskNode        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  sequence       Int
  isCarryForward Boolean         @default(false)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([planVersionId, sequence])
  @@unique([planVersionId, nodeId])
  @@index([nodeId])
}

model MilestoneNode {
  id                   String            @id @default(uuid())
  nodeId               String            @unique
  node                 TaskNode          @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  goal                 String
  completionCriteria   String
  expectedCompletedAt  DateTime          @db.Timestamptz(6)
  reviewRequirements   String
  submittedForReviewAt DateTime?         @db.Timestamptz(6)
  completedAt          DateTime?         @db.Timestamptz(6)
  reviews              MilestoneReview[]
}

model RevisionNode {
  id                  String           @id @default(uuid())
  nodeId              String           @unique
  node                TaskNode         @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  reason              String
  revisedFromNodeId   String?
  revisedFromNode     TaskNode?        @relation("RevisionRevisedFromNode", fields: [revisedFromNodeId], references: [id], onDelete: SetNull)
  basePlanVersionId   String
  basePlanVersion     TaskPlanVersion  @relation("RevisionBasePlanVersion", fields: [basePlanVersionId], references: [id], onDelete: Restrict)
  baseTaskLockVersion Int              @default(0)
  targetPlanVersion   TaskPlanVersion? @relation("RevisionTargetPlanVersion")
  status              RevisionStatus   @default(DRAFT)
  submittedAt         DateTime?        @db.Timestamptz(6)
  reviewedAt          DateTime?        @db.Timestamptz(6)
  effectiveAt         DateTime?        @db.Timestamptz(6)
  reviewedByAccountId String?
  reviewedBy          Account?         @relation("RevisionReviewedBy", fields: [reviewedByAccountId], references: [id], onDelete: SetNull)
  reviewComment       String           @default("")
  affectedSummary     Json             @default("{}")

  @@index([basePlanVersionId])
  @@index([revisedFromNodeId])
  @@index([reviewedByAccountId])
  @@index([status])
}

model TerminationNode {
  id                     String              @id @default(uuid())
  nodeId                 String              @unique
  node                   TaskNode            @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  plannedOutcomeCriteria String
  plannedAt              DateTime            @db.Timestamptz(6)
  outcome                TerminationOutcome?
  reason                 String              @default("")
  summary                String              @default("")
  confirmedByAccountId   String?
  confirmedBy            Account?            @relation("TerminationConfirmedBy", fields: [confirmedByAccountId], references: [id], onDelete: SetNull)
  confirmedAt            DateTime?           @db.Timestamptz(6)

  @@index([confirmedByAccountId])
  @@index([outcome])
}

model MilestoneReview {
  id                   String                @id @default(uuid())
  milestoneNodeId      String
  milestoneNode        MilestoneNode         @relation(fields: [milestoneNodeId], references: [id], onDelete: Restrict)
  result               MilestoneReviewResult @default(PENDING)
  submittedByAccountId String?
  submittedBy          Account?              @relation("MilestoneReviewSubmittedBy", fields: [submittedByAccountId], references: [id], onDelete: SetNull)
  reviewerAccountId    String?
  reviewer             Account?              @relation("MilestoneReviewReviewer", fields: [reviewerAccountId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?             @db.Timestamptz(6)
  comment              String                @default("")
  idempotencyKey       String
  revokedAt            DateTime?             @db.Timestamptz(6)
  revokedByAccountId   String?
  revokedBy            Account?              @relation("MilestoneReviewRevokedBy", fields: [revokedByAccountId], references: [id], onDelete: SetNull)
  revokeReason         String                @default("")
  evidences            ReviewEvidence[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)

  @@unique([milestoneNodeId, idempotencyKey])
  @@index([milestoneNodeId, createdAt])
  @@index([submittedByAccountId])
  @@index([reviewerAccountId])
  @@index([revokedByAccountId])
}

model ReviewEvidence {
  id          String             @id @default(uuid())
  reviewId    String
  review      MilestoneReview    @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  kind        ReviewEvidenceKind
  fileAssetId String?
  fileAsset   FileAsset?         @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  externalUrl String?
  note        String             @default("")
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)

  @@index([reviewId, sortOrder])
  @@index([fileAssetId])
}

model WorkSegment {
  id                     String              @id @default(uuid())
  personId               String
  person                 Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  type                   WorkSegmentType
  status                 WorkSegmentStatus
  startAt                DateTime            @db.Timestamptz(6)
  endAt                  DateTime            @db.Timestamptz(6)
  content                String
  role                   WorkSegmentRole     @default(DEVELOPER)
  customRole             String?
  priority               TaskPriority        @default(MEDIUM)
  expectedOutput         String              @default("")
  actualOutput           String              @default("")
  completionPercent      Decimal?            @db.Decimal(5, 2)
  taskId                 String?
  task                   Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  nodeId                 String?
  node                   TaskNode?           @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  associationNeedsReview Boolean             @default(false)
  createdByAccountId     String
  createdBy              Account             @relation("WorkSegmentCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  updatedByAccountId     String?
  updatedBy              Account?            @relation("WorkSegmentUpdatedBy", fields: [updatedByAccountId], references: [id], onDelete: SetNull)
  sourceSplitFromId      String?
  sourceSplitFrom        WorkSegment?        @relation("WorkSegmentSplit", fields: [sourceSplitFromId], references: [id], onDelete: SetNull)
  splitChildren          WorkSegment[]       @relation("WorkSegmentSplit")
  deletedAt              DateTime?           @db.Timestamptz(6)
  plannedSources         WorkSegmentSource[] @relation("PlannedSegmentSource")
  actualSources          WorkSegmentSource[] @relation("ActualSegmentSource")
  changes                WorkSegmentChange[]
  tags                   SegmentTag[]
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)

  @@index([personId, type, startAt, endAt])
  @@index([taskId, startAt])
  @@index([nodeId, type])
  @@index([associationNeedsReview, personId])
  @@index([createdByAccountId])
  @@index([updatedByAccountId])
  @@index([sourceSplitFromId])
  @@index([deletedAt])
  @@index([updatedAt, id])
}

model SegmentTag {
  id        String      @id @default(uuid())
  segmentId String
  segment   WorkSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([segmentId, tagId])
  @@index([tagId])
}

model WorkSegmentSource {
  id                 String      @id @default(uuid())
  plannedSegmentId   String
  plannedSegment     WorkSegment @relation("PlannedSegmentSource", fields: [plannedSegmentId], references: [id], onDelete: Restrict)
  actualSegmentId    String
  actualSegment      WorkSegment @relation("ActualSegmentSource", fields: [actualSegmentId], references: [id], onDelete: Restrict)
  coveredStartAt     DateTime    @db.Timestamptz(6)
  coveredEndAt       DateTime    @db.Timestamptz(6)
  createdByAccountId String
  createdBy          Account     @relation("WorkSegmentSourceCreatedBy", fields: [createdByAccountId], references: [id], onDelete: Restrict)
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([plannedSegmentId, actualSegmentId, coveredStartAt, coveredEndAt])
  @@index([actualSegmentId])
  @@index([createdByAccountId])
}

model WorkSegmentChange {
  id             String                  @id @default(uuid())
  segmentId      String
  segment        WorkSegment             @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  action         WorkSegmentChangeAction
  before         Json?
  after          Json?
  reason         String                  @default("")
  actorAccountId String?
  actor          Account?                @relation("WorkSegmentChangeActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)

  @@index([segmentId, createdAt])
  @@index([actorAccountId])
}

model SystemRoleAssignment {
  id                 String                      @id @default(uuid())
  accountId          String
  account            Account                     @relation("SystemRoleAccount", fields: [accountId], references: [id], onDelete: Restrict)
  role               ProjectManagementSystemRole
  team               String                      @default("")
  techGroup          String                      @default("")
  grantedByAccountId String?
  grantedBy          Account?                    @relation("SystemRoleGrantedBy", fields: [grantedByAccountId], references: [id], onDelete: SetNull)
  revokedByAccountId String?
  revokedBy          Account?                    @relation("SystemRoleRevokedBy", fields: [revokedByAccountId], references: [id], onDelete: SetNull)
  revokedAt          DateTime?                   @db.Timestamptz(6)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(6)

  @@index([accountId, role])
  @@index([role, team, techGroup])
  @@index([grantedByAccountId])
  @@index([revokedByAccountId])
  @@index([revokedAt])
}

model NotificationPreference {
  id        String                                @id @default(uuid())
  accountId String
  account   Account                               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category  ProjectManagementNotificationCategory
  channel   ProjectManagementNotificationChannel
  enabled   Boolean                               @default(true)
  createdAt DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                              @updatedAt @db.Timestamptz(6)

  @@unique([accountId, category, channel])
}

model InAppNotification {
  id                 String                                @id @default(uuid())
  eventKey           String?                               @unique
  recipientAccountId String
  recipient          Account                               @relation(fields: [recipientAccountId], references: [id], onDelete: Restrict)
  category           ProjectManagementNotificationCategory
  title              String
  summary            String                                @default("")
  entityType         String
  entityId           String
  taskId             String?
  task               Task?                                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  linkPath           String                                @default("")
  payloadVersion     Int                                   @default(1)
  payload            Json                                  @default("{}")
  readAt             DateTime?                             @db.Timestamptz(6)
  createdAt          DateTime                              @default(now()) @db.Timestamptz(6)

  @@index([recipientAccountId, readAt, createdAt])
  @@index([category, createdAt])
  @@index([taskId])
  @@index([readAt, createdAt])
}

model DomainAuditEvent {
  id             String      @id @default(uuid())
  actorAccountId String?
  actorAccount   Account?    @relation("AuditActorAccount", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorPersonId  String?
  actorPerson    Person?     @relation("AuditActorPerson", fields: [actorPersonId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  taskId         String?
  task           Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  before         Json?
  after          Json?
  reason         String      @default("")
  requestId      String      @default("")
  source         AuditSource @default(WEB)
  schemaVersion  Int         @default(1)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorAccountId, createdAt])
  @@index([actorPersonId, createdAt])
  @@index([source, createdAt])
}

model NotificationOutbox {
  id          String                        @id @default(uuid())
  eventKey    String                        @unique
  channel     String
  botKind     String                        @default("notification")
  type        String
  payload     String
  status      NotificationOutboxStatus      @default(PENDING)
  attempts    Int                           @default(0)
  lastError   String                        @default("")
  nextRunAt   DateTime                      @default(now())
  lockedUntil DateTime?
  sentAt      DateTime?
  recipients  NotificationOutboxRecipient[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([status, nextRunAt])
  @@index([channel, status, updatedAt])
}

model NotificationOutboxRecipient {
  id            String                   @id @default(uuid())
  outboxId      String
  outbox        NotificationOutbox       @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  openId        String
  receiveId     String                   @default("")
  receiveIdType String                   @default("")
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  lastError     String                   @default("")
  nextRunAt     DateTime                 @default(now())
  lockedUntil   DateTime?
  sentAt        DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([outboxId, openId])
  @@index([outboxId, status])
  @@index([status, nextRunAt])
}
