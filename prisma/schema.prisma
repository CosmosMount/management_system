generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  DRAFT
  MANAGEMENT_REVIEW
  TEACHER_REVIEW
  PENDING_APPLICANT_DOCS
  PENDING_FINANCE_REVIEW
  PENDING_APPLICANT_CONFIRM
  COMPLETED
  REJECTED
}

enum UserRoleType {
  SUPER_ADMIN
  TEAM_ADMIN
  TECH_GROUP_ADMIN
  TEACHER
  FINANCE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum FileAssetKind {
  ORDER_ATTACHMENT
  ORDER_ITEM_IMAGE
  FEEDBACK_ATTACHMENT
  USER_SIGNATURE
  TEMP_UPLOAD
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id            String          @id @default(uuid())
  openId        String          @unique
  unionId       String?         @unique
  name          String
  email         String?
  avatar        String?
  signaturePath String?
  createdAt     DateTime        @default(now())
  orders        PurchaseOrder[]
}

model ProcurementFeishuCard {
  id        String   @id @default(uuid())
  orderId   String
  openId    String
  cardId    String
  botKind   String
  cardStage String   @default("")
  sequence  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, openId])
  @@index([orderId])
}

model UserRole {
  id        String       @id @default(uuid())
  openId    String
  role      UserRoleType
  team      String       @default("")
  techGroup String       @default("")

  @@unique([openId, role, team, techGroup])
}

model ProcurementBudgetPool {
  id                 String   @id @default(uuid())
  /** 项目名（导入表「项目」列） */
  description        String   @default("")
  team               String
  techGroup          String
  period             String
  budgetAmount       Float
  /** 看板/管理页展示顺序，与 Excel 导入行序一致 */
  sortOrder          Int      @default(0)
  lastAlertThreshold Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([description, team, techGroup, period])
}

model PurchaseOrder {
  id                      String         @id @default(uuid())
  orderNo                 String         @unique
  initiatorId             String
  initiator               User           @relation(fields: [initiatorId], references: [id])
  initiatorName           String
  team                    String
  techGroup               String
  totalPrice              Float          @default(0)
  teamApproved            Boolean        @default(false)
  techGroupApproved       Boolean        @default(false)
  teamApproverOpenId      String?
  techGroupApproverOpenId String?
  invoicePaths            String         @default("[]")
  invoicePath             String?
  listDocPath             String?
  screenshotPath          String?
  status                  OrderStatus    @default(DRAFT)
  isWorkshopFee           Boolean        @default(false)
  rejectionReason         String?
  rejectedAt              DateTime?
  rejectedByName          String?
  lastReminderAt          DateTime?
  statusEnteredAt         DateTime       @default(now())
  items                   PurchaseItem[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

enum PurchaseItemKind {
  COMPONENT
  STANDARD_PART
  PROCESSING_FEE
}

model ProcessingVendor {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model PurchaseItem {
  id                 String           @id @default(uuid())
  orderId            String
  order              PurchaseOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name               String
  spec               String
  itemKind           PurchaseItemKind @default(COMPONENT)
  purchaseLink       String           @default("")
  referenceImagePath String?
  processingVendor   String           @default("")
  quantity           Int
  unitPrice          Float
  photoPath          String?
  updatedAt          DateTime         @default(now()) @updatedAt
}

model Feedback {
  id              String            @id @default(uuid())
  submitterOpenId String
  submitterName   String
  status          FeedbackStatus    @default(OPEN)
  lastMessageAt   DateTime          @default(now())
  closedAt        DateTime?
  messages        FeedbackMessage[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([submitterOpenId])
  @@index([status, lastMessageAt])
}

model FeedbackMessage {
  id           String               @id @default(uuid())
  feedbackId   String
  feedback     Feedback             @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorOpenId String
  authorName   String
  body         String               @default("")
  attachments  FeedbackAttachment[]
  createdAt    DateTime             @default(now())

  @@index([feedbackId, createdAt])
}

model FeedbackAttachment {
  id        String          @id @default(uuid())
  messageId String
  message   FeedbackMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  path      String
  fileName  String
  mimeType  String
  size      Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
}

model FileAsset {
  id                   String        @id @default(uuid())
  publicPath           String        @unique
  storagePath          String
  kind                 FileAssetKind
  mimeType             String
  size                 Int
  orderId              String?
  feedbackId           String?
  signatureOwnerOpenId String?
  ownerOpenId          String?
  createdAt            DateTime      @default(now())

  @@index([orderId])
  @@index([feedbackId])
  @@index([signatureOwnerOpenId])
  @@index([ownerOpenId])
}

model NotificationOutbox {
  id          String                        @id @default(uuid())
  eventKey    String                        @unique
  channel     String
  botKind     String                        @default("notification")
  type        String
  payload     String
  status      NotificationOutboxStatus      @default(PENDING)
  attempts    Int                           @default(0)
  lastError   String                        @default("")
  nextRunAt   DateTime                      @default(now())
  lockedUntil DateTime?
  sentAt      DateTime?
  recipients  NotificationOutboxRecipient[]
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([status, nextRunAt])
}

model NotificationOutboxRecipient {
  id            String                   @id @default(uuid())
  outboxId      String
  outbox        NotificationOutbox       @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  openId        String
  receiveId     String                   @default("")
  receiveIdType String                   @default("")
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  lastError     String                   @default("")
  nextRunAt     DateTime                 @default(now())
  lockedUntil   DateTime?
  sentAt        DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([outboxId, openId])
  @@index([outboxId, status])
  @@index([status, nextRunAt])
}
