{
  "name": "management_system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:local": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc --noEmit --incremental false",
    "typecheck:scripts": "tsc --noEmit --incremental false -p tsconfig.scripts.json",
    "check:dependencies": "tsx scripts/check-source-dependencies.ts",
    "check": "prisma validate && npm run typecheck && npm run typecheck:scripts && npm run test:node && npm run check:dependencies && eslint app components lib scripts tests --max-warnings=0 && git diff --check",
    "cron": "tsx scripts/cron.ts",
    "feishu:ws": "tsx scripts/feishu-ws.ts",
    "feishu:card-preview": "tsx scripts/test-feishu-approval-card.ts",
    "pm:p0-baseline": "tsx scripts/project-management-p0-baseline.ts",
    "pm:identity-backfill": "tsx scripts/project-management-identity-backfill.ts",
    "pm:release-rehearsal": "tsx scripts/project-management-release-rehearsal.ts",
    "pm:task-access-preflight": "tsx scripts/preflight-task-access-migration.ts",
    "pm:repair-task-approval-notifications": "tsx scripts/repair-task-approval-notifications.ts",
    "postinstall": "prisma generate",
    "db:deploy": "tsx scripts/deploy-db.ts",
    "accounts:preflight": "tsx scripts/preflight-unified-accounts.ts",
    "accounts:validate": "tsx scripts/validate-unified-accounts.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:roles:validate": "tsx scripts/validate-user-roles.ts",
    "db:studio": "prisma studio",
    "test:node": "tsx scripts/verify-node-test-runner-safety.ts && tsx scripts/run-node-tests.ts",
    "test:playwright-db-lifecycle": "tsx scripts/verify-playwright-runner-lifecycle.ts",
    "test:playwright-db-safety": "tsx scripts/verify-playwright-db-safety.ts",
    "prepare:template": "tsx scripts/prepare-reimbursement-template.ts",
    "test:e2e": "NODE_OPTIONS='' tsx scripts/run-playwright.ts",
    "test:e2e:smoke": "NODE_OPTIONS='' tsx scripts/run-playwright.ts --grep=@smoke",
    "test:e2e:full": "NODE_OPTIONS='' tsx scripts/run-playwright.ts",
    "test:e2e:nightly": "PM_RUN_SCALE_TESTS=true NODE_OPTIONS='' tsx scripts/run-playwright.ts",
    "test:nightly": "npm run check && npm run test:playwright-db-lifecycle && npm run test:playwright-db-safety && npm run test:e2e:nightly && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docxtemplater": "^3.69.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "node-cron": "^4.5.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.0",
    "pizzip": "^3.2.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
